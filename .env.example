OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional: use OpenRouter instead of OpenAI. Put your OpenRouter key in
# OPENAI_API_KEY above and pick a free model that supports structured outputs.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=inclusionai/ling-3.2-flash:free

# Optional limits (defaults: 8000 output tokens, 60 seconds)
# OPENAI_MAX_OUTPUT_TOKENS=8000
# OPENAI_TIMEOUT_SECONDS=60
